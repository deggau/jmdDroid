+    private async Task SendAndroidScreenShareKeyAsync(string deviceId, AndroidScreenShareWindow window, string shareId, int keyCode, string action, int metaState)
+    {
+        var server = _jmdroidApiServer;
+        if (server is null) return;
+        var sent = await server.SendScreenShareKeyAsync(deviceId, shareId, keyCode, action, metaState);
+        if (!sent && window.IsVisible && window.ShareId == shareId)
+            window.SetTransientStatus("O Android não recebeu a tecla. Confirme se a transmissão continua ativa.");
